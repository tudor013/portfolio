---
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  /** Page title, used for <title> and as the Open Graph title. */
  title: string;
  /** One sentence; shows in search results and in LinkedIn link previews. */
  description: string;
  /**
   * `page` puts the content in the site's frame (inner pages). `full` hands
   * each section the whole width, which the landing page needs for the
   * blueprint field and the held scenes.
   */
  layout?: 'page' | 'full';
  /** `night` swaps the paper for a black ground with light-blue ink (tokens.css). */
  theme?: 'paper' | 'night';
}

const { title, description, layout = 'page', theme = 'paper' } = Astro.props;

// Astro.site comes from `site` in astro.config.mjs. Open Graph requires
// absolute URLs, so relative paths would silently produce broken previews.
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-motion="full" data-motion-choice="system" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />

    {/* Runs before the first paint so the page never draws in the wrong
        motion mode and then jumps. The key matches STORAGE_KEY in
        scripts/motion.ts. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let saved = null;
        try {
          saved = localStorage.getItem('portfolio-motion');
        } catch {
          // The operating-system preference remains available without storage.
        }
        const userChoice = saved === 'full' || saved === 'reduced';
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        root.dataset.motion = userChoice ? saved : reduced ? 'reduced' : 'full';
        root.dataset.motionChoice = userChoice ? 'user' : 'system';
      })();
    </script>

    {/* Emits the self-hosted @font-face rules. Deliberately not preloaded:
        `preload` covers every variant of the family, which here is eight
        files competing with the text that drives LCP. Astro emits
        metric-matched fallbacks, so the real face swaps in without shifting
        layout. */}
    <Font cssVariable="--font-text" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- TODO(conținut): og:image — 1200×630 preview card for LinkedIn. -->
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class:list={[layout === 'page' && 'page frame']}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<script>
  import { initMotionToggle } from '../scripts/motion';
  import { initEnter } from '../scripts/enter';
  import { initSmoothScroll } from '../scripts/smooth-scroll';

  initMotionToggle();
  initEnter();
  initSmoothScroll();
</script>

<style>
  .page {
    max-width: 76rem;
    margin-inline: auto;
    padding-block: var(--space-16) var(--section-gap);
  }
</style>
