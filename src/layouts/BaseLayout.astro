---
import { Font } from 'astro:assets';
import ScrollLight from '../components/ScrollLight.astro';
import '../styles/global.css';

interface Props {
  /** Page title, used for <title> and as the Open Graph title. */
  title: string;
  /** One sentence; shows in search results and in LinkedIn link previews. */
  description: string;
}

const { title, description } = Astro.props;

// Astro.site comes from `site` in astro.config.mjs. Open Graph requires
// absolute URLs, so relative paths would silently produce broken previews.
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />

    {/* Emits the self-hosted @font-face rules. Deliberately not preloaded:
        `preload` covers every variant of a family, which here is six files
        competing with the text that drives LCP. Astro emits metric-matched
        fallbacks, so the real face swaps in without shifting layout. */}
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- TODO(conținut): og:image — 1200×630 preview card for LinkedIn. -->
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <ScrollLight />
    <main id="main" class="page">
      <slot />
    </main>
  </body>
</html>

<script>
  import { initReveal } from '../scripts/reveal';

  // Cards and timeline rows only. Fading in whole sections is the pattern that
  // reads as generated, and it delays the text a reader came for.
  initReveal('.grid > li, .timeline > li');
</script>
