---
/**
 * Roles and education, newest first, straight from the CV. Dates and titles
 * are reproduced as written there — a portfolio that disagrees with the CV a
 * recruiter is holding costs more than it gains.
 */
const ROLES = [
  {
    org: 'SiSC — Cybernetics Students’ Union',
    title: 'Head of UI/UX Division',
    period: 'Jul 2026 — present',
    notes: [
      'Created the division’s working process from scratch.',
      'Started rebuilding the association’s websites.',
    ],
  },
  {
    org: 'Soft Tehnica',
    title: 'Junior Programmer',
    period: 'Jun 2026 — Jul 2026',
    notes: ['Worked with senior developers on AI solutions, using Python to optimise models.'],
  },
  {
    org: 'Aruna Coffee',
    title: 'Co-founder',
    period: 'Sep 2025 — present',
    notes: [
      'Co-founded and ran the brand, from concept through to execution.',
      'Built the shop’s frontend and backend, and handled its web security.',
    ],
  },
];

const STUDY = {
  org: 'Faculty of Cybernetics, Statistics and Economic Informatics',
  title: 'Economic Informatics',
  period: 'expected Jul 2028',
  notes: [
    'Built an agent-based simulation of a news-driven stock market, comparing fundamentals-based analysis against herd behaviour.',
    'Three national awards and a top-half international placing in robotics competitions.',
  ],
};
---

<section id="experience" aria-labelledby="experience-heading">
  <div class="head">
    <h2 id="experience-heading">Experience</h2>
  </div>

  <ol class="timeline">
    {
      [...ROLES, STUDY].map((entry) => (
        <li class="entry">
          <div class="when">
            <span class="figure meta">{entry.period}</span>
          </div>

          <div class="what">
            <h3>{entry.title}</h3>
            <p class="org">{entry.org}</p>
            <ul>
              {entry.notes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  section[id='experience'] {
    padding-block: var(--space-12);
  }

  .head {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  h2 {
    margin: 0;
  }

  .timeline {
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .entry:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .when {
    padding-top: var(--space-1);
  }

  h3 {
    margin: 0;
    font-size: var(--text-h3);
  }

  .org {
    margin: var(--space-1) 0 var(--space-3);
    max-width: none;
    color: var(--text-muted);
    font-size: var(--text-secondary);
  }

  .what ul {
    margin: 0;
    padding-left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .what li {
    font-size: var(--text-secondary);
  }

  /* The date column folds above the role rather than squeezing it. */
  @media (max-width: 46rem) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }
  }
</style>
