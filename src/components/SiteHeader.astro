---
// A plain bar: the name, the three directions, one way to get in touch. No
// glass, no pill. It stays at the top so contact is one click from anywhere,
// and it is opaque so it reads the same over paper and over the blueprint.
import { CATEGORIES, CATEGORY_SHORT, CATEGORY_SLUGS } from '../content.config';

const LINKS = CATEGORIES.map((category) => ({
  href: `/${CATEGORY_SLUGS[category]}/`,
  label: CATEGORY_SHORT[category],
}));

// Trailing slashes vary between the dev server and the built output, so the
// comparison is made on a normalised path rather than on the raw string.
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="bar frame" data-header>
  <a class="wordmark" href="/">Tudor-Andrei Ifrim</a>

  <nav aria-label="Main">
    <ul>
      {
        LINKS.map((link) => {
          const current = here === link.href.replace(/\/+$/, '');
          return (
            <li>
              <a href={link.href} aria-current={current ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <a class="contact" href="/#contact">Get in touch</a>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    min-height: 4rem;
    background: var(--ground);
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .wordmark {
    justify-self: start;
    font-weight: var(--weight-head);
  }

  nav ul {
    display: flex;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* An underline that draws in from the left on hover, and stays drawn on the
     page you are on: position marked by shape, not by colour alone. */
  nav a {
    position: relative;
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--t-ui) var(--ease-out);
  }

  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .contact {
    justify-self: end;
    font-weight: var(--weight-head);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  /* On a phone the three directions take their own row under the name. */
  @media (max-width: 40rem) {
    .bar {
      grid-template-columns: 1fr auto;
      padding-block: var(--space-1);
    }

    nav {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    nav ul {
      gap: var(--space-6);
    }
  }
</style>
