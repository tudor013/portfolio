---
// A plain bar: the name, the three directions, contact and a motion control.
// It stays opaque over both paper and the blueprint field.
import { CATEGORIES, CATEGORY_SHORT, CATEGORY_SLUGS } from '../content.config';

const LINKS = CATEGORIES.map((category) => ({
  href: `/${CATEGORY_SLUGS[category]}/`,
  label: CATEGORY_SHORT[category],
}));

// Trailing slashes vary between the dev server and the built output, so the
// comparison is made on a normalised path rather than on the raw string.
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="bar frame" data-header>
  <a class="wordmark" href="/">Tudor-Andrei Ifrim</a>

  <nav aria-label="Main">
    <ul>
      {
        LINKS.map((link) => {
          const current = here === link.href.replace(/\/+$/, '');
          return (
            <li>
              <a href={link.href} aria-current={current ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          );
        })
      }
      <li><a href="/#contact">Get in touch</a></li>
    </ul>
  </nav>

  <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="true" hidden>
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <path d="M2 11h4l3-7v13l3-7h6" />
    </svg>
    Motion <span class="state" aria-hidden="true" data-motion-state>on</span>
  </button>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    min-height: 4rem;
    background: var(--ground);
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .wordmark {
    justify-self: start;
    font-weight: var(--weight-head);
  }

  .motion-toggle {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-3);
    border: 0;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: var(--step-small);
    cursor: pointer;
  }

  .motion-toggle[hidden] {
    display: none;
  }

  .motion-toggle:hover {
    background: color-mix(in srgb, var(--surface) 92%, var(--ink));
  }

  .state {
    min-width: 1.6em;
    font-weight: var(--weight-head);
  }

  .motion-toggle svg {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .motion-toggle path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  nav ul {
    display: flex;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* An underline that draws in from the left on hover, and stays drawn on the
     page you are on: position marked by shape, not by colour alone. */
  nav a {
    position: relative;
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--t-ui) var(--ease-out);
  }

  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* Below desktop width the directions take their own row under the name;
     four links and the motion control beside it would squeeze the name onto
     two lines. */
  @media (max-width: 60rem) {
    .bar {
      grid-template-columns: 1fr auto;
      padding-block: var(--space-1);
    }

    nav {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    nav ul {
      flex-wrap: wrap;
      gap: 0 var(--space-6);
    }
  }
</style>
