---
// Wayfinding only. A portfolio has two destinations worth naming; cramming
// more in would make the one that matters harder to find.
---

<header class="bar">
  <a class="wordmark" href="/">Tudor-Andrei Ifrim</a>
  <nav aria-label="Main">
    <a href="/#work">Work</a>
    <a href="/#contact">Contact</a>
  </nav>
</header>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
  }

  .wordmark {
    color: var(--text-primary);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: var(--space-6);
  }
</style>
