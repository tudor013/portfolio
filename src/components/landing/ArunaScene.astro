---
/**
 * Chapter three, Design: stills from the Spline scenes Tudor made for Aruna
 * Coffee and two more pieces of his graphic work, crossfading by themselves, each pushing in slowly while
 * it is on screen. This is the page's signature move: the picture changes as
 * its part of the story arrives.
 *
 * Without the held scene (no script, reduced motion, narrow screens) the
 * pictures sit in a grid: the same content, finished.
 */
import { Image } from 'astro:assets';
import wordmark from '../../assets/landing/aruna-1-wordmark.webp';
import swan from '../../assets/landing/aruna-3-swan.webp';
import product from '../../assets/landing/aruna-4-product.webp';
import poster from '../../assets/landing/poster-silhouettes.webp';
import quiz from '../../assets/landing/quiz-start.webp';

const FRAMES = [
  {
    src: wordmark,
    alt: 'The coffee brand’s wordmark above a small black cup with a cream sleeve, on a white ground.',
  },
  {
    src: swan,
    alt: 'The cup seen up close: its cream sleeve carries a black swan in a white oval.',
  },
  {
    src: product,
    alt: 'A paper cup lit from one side on a dark brown ground, beside the line “Cu sau fără zahăr? Indiferent de alegere, gustul autentic rămâne același.”',
  },
  {
    src: poster,
    alt: 'A dark red poster with vertical stripes: two black silhouettes, one leaning over a ledge and one reaching up towards it from below.',
    top: true,
  },
  {
    src: quiz,
    alt: 'The word “QUIZ” in green pixel letters over a halftone dot pattern, with “START” and a play arrow beneath it.',
  },
];
---

<section class="aruna" id="aruna" aria-labelledby="aruna-heading" data-aruna>
  <div class="stage">
    <div class="text">
      <div class="copy" data-enter>
        <h2 id="aruna-heading">Drawn before it was built</h2>
        <p>
          I designed a coffee brand and drew its interface in Illustrator
          before any of it was built. I made the moving scenes behind its
          online shop in Spline; the shop’s controls sit on top of them, in
          code.
        </p>
      </div>
      <p class="links">
        <a class="go" href="/design/">All design work</a>
      </p>
    </div>

    {/* The pictures change by themselves; WCAG 2.2.2 asks for a way to stop
        anything that moves on its own for more than five seconds. */}
    <button class="cycle" type="button" data-cycle hidden aria-pressed="false">Pause</button>

    <ol class="frames">
      {
        FRAMES.map((frame, i) => (
          <li data-frame={i}>
            <figure>
              <div class="picture">
                <Image
                  class:list={[frame.top && 'top']}
                  src={frame.src}
                  alt={frame.alt}
                  widths={[560, 900, 1300]}
                  sizes="(min-width: 75rem) 62vw, (min-width: 40rem) 45vw, 92vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </figure>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .aruna {
    padding-block: var(--space-16);
  }

  .stage {
    display: grid;
    gap: var(--space-12);
    padding-inline: var(--margin);
    /* Centred, like every section: on a wide screen the text and the
       picture stay together instead of drifting to the edges. */
    width: min(100%, calc(var(--content) + 2 * var(--margin)));
    margin-inline: auto;
  }

  .text {
    display: grid;
    align-content: start;
    gap: var(--space-8);
  }

  .copy {
    display: grid;
    gap: var(--space-4);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-8);
    max-width: none;
  }

  /* Finished composition: the pictures two by two. */
  .frames {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  figure {
    margin: 0;
  }

  .picture {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--surface);
  }

  .picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The square poster is cropped to the frame from the top, so the figure
     leaning over the ledge keeps its head. */
  .picture img.top {
    object-position: center top;
  }


  @media (max-width: 40rem) {
    .text {
      padding-left: 0;
    }

    .frames {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- Live: one screen, one picture at a time, changing by itself ------- */

  .aruna.is-live {
    height: calc(100svh - 4rem);
    padding-block: 0;
  }

  .aruna.is-live .stage {
    position: relative;
    height: 100%;
    overflow: clip;
    grid-template-columns: minmax(0, 6fr) minmax(0, 7fr);
    grid-template-rows: minmax(0, 1fr) auto;
    align-items: center;
    row-gap: var(--space-4);
    padding-block: var(--space-8);
  }

  /* The heading needs the width to stay on two lines; the picture gives it. */
  .aruna.is-live .text {
    grid-row: 1 / -1;
    padding-left: 0;
    max-width: 34rem;
  }

  .aruna.is-live .frames {
    grid-column: 2;
    grid-row: 1;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'frame';
    /* As large as the screen allows, and never taller than it. */
    width: min(100%, calc((100svh - 4rem - var(--space-24) - 44px) * 4 / 3));
    justify-self: end;
  }

  .aruna.is-live li {
    grid-area: frame;
    opacity: 0;
    transition: opacity 900ms var(--ease-in-out);
  }

  .aruna.is-live li.is-shown {
    opacity: 1;
  }

  /* Each picture pushes in slowly while it is on screen. */
  .aruna.is-live .picture img {
    transition: transform 3600ms linear;
  }

  .aruna.is-live li.is-shown .picture img {
    transform: scale(1.06);
  }

  .cycle {
    display: none;
  }

  .aruna.is-live .cycle {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 0;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: var(--step-small);
    cursor: pointer;
  }

  .aruna.is-live .cycle:hover {
    background: color-mix(in srgb, var(--surface) 92%, var(--ink));
  }
</style>

<script>
  import { initArunaScene } from '../../scripts/aruna-scene';

  const root = document.querySelector<HTMLElement>('[data-aruna]');
  if (root) initArunaScene(root);
</script>
