---
/**
 * The first screen: who this is, what he does, and how to act on it. On the
 * right the ID badge hangs; below the text, on a drafting sheet, a binary
 * search tree builds itself when the page opens (SearchTree).
 *
 * The first screen holds only the name, the sentence, the two actions, the
 * tree and the badge. Availability is said in the intro's "Where" and in the
 * contact section; here it would only crowd the opening.
 *
 * The load sequence of the text is CSS only, so it runs from the first frame
 * and never waits on a script.
 */
import IdBadge from '../IdBadge.astro';
import SearchTree from './SearchTree.astro';
---

<section class="hero frame" aria-labelledby="hero-heading">
  <div class="drafting-sheet" aria-hidden="true">
    <svg focusable="false">
      <defs>
        <pattern id="hero-grid" width="32" height="32" patternUnits="userSpaceOnUse">
          <path class="grid" d="M32 0H0V32" />
        </pattern>
        <pattern id="hero-grid-major" width="160" height="160" patternUnits="userSpaceOnUse">
          <path class="grid-major" d="M160 0H0V160" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)" />
      <rect width="100%" height="100%" fill="url(#hero-grid-major)" />
    </svg>
  </div>

  <div class="column">
    <h1 id="hero-heading"><span class="keep">Tudor-Andrei</span> Ifrim</h1>

    <p class="sentence">
      Software developer in Bucharest. I build software people enjoy using, for
      problems they actually have.
    </p>

    <p class="actions">
      <a class="button" href="#work">See the work</a>
      <a class="go" href="#contact">Get in touch</a>
    </p>
  </div>

  <div class="tree-area">
    <SearchTree />
  </div>

  <div class="badge-slot">
    <IdBadge />
  </div>

</section>

<style>
  .hero {
    --hero-start: calc(var(--column-start) * 0.35);
    isolation: isolate;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    /* Exactly the first screen below the header: the next section starts
       where the screen ends. */
    grid-template-rows: minmax(calc(100svh - 4rem), auto);
    column-gap: var(--space-8);
  }

  /* A faint drafting grid behind the badge and the tree. The only decorative
     lines on the page, and only here (.ux-profile.md). */
  .drafting-sheet {
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    opacity: 0.58;
    /* A mask, not a fill: the sheet stays clear around the name and the
       sentence and shows under the tree and the badge. Gradients are allowed
       by Tudor; these masks are the only ones. */
    mask-image: radial-gradient(ellipse 48% 42% at 30% 28%, transparent 55%, black 100%); /* taste-skill-ignore */
  }

  .drafting-sheet svg {
    width: 100%;
    height: 100%;
  }

  .grid {
    fill: none;
    stroke: var(--draft-grid);
    stroke-width: 0.7;
  }

  .grid-major {
    fill: none;
    stroke: var(--draft-line);
    stroke-width: 0.9;
  }

  /* Above the badge's box: the name runs a little into the badge column, and
     the transparent box the strap is drawn in must not sit over it. */
  .column {
    position: relative;
    /* Above the badge's slot as well as the sheet. */
    z-index: 2;
    grid-row: 1;
    grid-column: 1;
    display: grid;
    align-content: start;
    gap: var(--space-6);
    /* Closer to the left than the other sections' content, so the name and
       the badge are not squeezed together. */
    padding-left: var(--hero-start);
    padding-block: clamp(1.5rem, 5vh, 3rem);
  }

  /* The name is the one big thing, and it may run wider than the column. It
     breaks only between the two names, never at the hyphen, so it is always
     two lines. */
  h1 {
    /* Wider than "Tudor-Andrei", narrower than the full name. */
    width: 7.5em;
    max-width: none;
    margin-bottom: var(--space-2);
  }

  .keep {
    white-space: nowrap;
  }

  .sentence {
    max-width: 30ch;
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-8);
  }

  /* Spans both rows: the badge's box is 760px tall, and in the first row
     alone it would stretch the first screen past the bottom of a short
     window. */
  .badge-slot {
    position: relative;
    z-index: 1;
    grid-row: 1 / -1;
    grid-column: 2;
    /* The strap hangs from the header's bottom edge. */
    align-self: start;
    margin-right: calc(var(--space-8) * -1);
  }

  /* The room under the text that the availability line left: the tree is
     drawn there, on the sheet, clear of the name and of the badge. */
  .tree-area {
    position: relative;
    z-index: 1;
    grid-row: 1;
    grid-column: 1;
    align-self: end;
    max-width: 34rem;
    height: clamp(10rem, 24vh, 15rem);
    margin: 0 0 var(--space-8) var(--hero-start);
    container: tree / inline-size;
  }


  /* ---- Load sequence ---------------------------------------------------- */

  :global(html[data-motion='full']) .column > * {
    animation: rise var(--t-reveal) var(--ease-expo) both;
  }

  :global(html[data-motion='full']) .column > :nth-child(2) { animation-delay: 90ms; }
  :global(html[data-motion='full']) .column > :nth-child(3) { animation-delay: 180ms; }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.6em);
      filter: blur(6px);
    }
  }

  /* ---- Narrow ----------------------------------------------------------- */

  /* A tablet keeps the two columns, with a narrower box for the badge; the
     strap still hangs from the header. */
  @media (max-width: 60rem) {
    .hero {
      column-gap: var(--space-4);
      grid-template-rows: minmax(calc(100svh - 6.5rem), auto);
      /* A card swung to the edge must never widen the page. `clip` cuts the
         sideways overflow only, so the strap can still drop in from above. */
      overflow-x: clip;
    }

    .column {
      padding-left: 0;
    }

    .badge-slot {
      width: 20rem;
      margin-right: 0;
    }

    .badge-slot :global(.badge) {
      width: 100%;
    }

    .tree-area {
      width: 100%;
      margin-left: 0;
    }


    .drafting-sheet {
      opacity: 0.42;
    }
  }

  /* A phone has no room beside the text, so the badge gets a band of its own
     under it, one tone down, and hangs from the band's top edge; the tree
     sits at the top of the band. */
  @media (max-width: 40rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
    }

    .column {
      grid-row: auto;
      grid-column: auto;
      padding-block: var(--space-8);
    }

    h1 {
      width: auto;
    }

    .badge-slot {
      grid-row: auto;
      grid-column: auto;
      width: auto;
      height: 36rem;
      margin-inline: calc(var(--margin) * -1);
      background: var(--surface);
      display: grid;
      justify-items: center;
    }

    .tree-area {
      grid-row: auto;
      height: 12rem;
      margin-bottom: var(--space-8);
    }


    .drafting-sheet {
      opacity: 0.3;
      mask-image: none;
    }
  }
</style>
