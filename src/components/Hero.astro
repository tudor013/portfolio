---
import SignalTrace from './SignalTrace.astro';
import IdBadge from './IdBadge.astro';

// One promise, two actions — the landing-hero job. The signal trace carries
// the page's single bold moment so everything below it can stay quiet.

/** TODO(conținut): the real series — simulation output or commit cadence. */
const TRACE: number[] = [];
const TRACE_CAPTION = 'TODO(conținut): ce reprezintă seria.';
---

<section class="hero">
  <div class="intro">
    <h1>Tudor-Andrei Ifrim</h1>

  <p class="promise">
    I build software people enjoy using, for problems they actually have.
  </p>

  <p class="actions">
    <a class="action action--primary" href="#work">See the work</a>
    <a class="action" href="#contact">Get in touch</a>
  </p>

  {/* TODO(conținut): pass the real series and the trace appears. Rendering
      it empty would put a dead box in the most valuable space on the page,
      and inventing a curve would fake the evidence the page argues from. */}
  {TRACE.length > 1 && (
      <SignalTrace points={TRACE} label="Signal trace" caption={TRACE_CAPTION} />
    )}
  </div>

  <div class="badge-slot">
    <IdBadge />
  </div>
</section>

<style>
  /* Top-aligned, not centred: the badge column is far taller than the text,
     so centring pushed the name a third of the way down the page. The name
     is the first thing to read, so it starts where the reader's eye does. */
  .intro {
    align-self: start;
  }

  .hero {
    /* One source for the gap under the header: the badge cancels exactly this
       much to hang from the header's edge, and a mismatch would show as the
       strap starting in mid-air. */
    --hero-top: var(--space-8);

    display: grid;
    /* The badge keeps its intrinsic width; the text takes what is left. */
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-12);
    /* The badge column starts at the top of the content area so the lanyard
       hangs from just under the header; the text stays optically centred
       against it. */
    align-items: start;
    padding-block: var(--hero-top) var(--space-12);
  }

  /* Below the two-column threshold the badge moves under the text rather than
     squeezing it. Desktop is the priority, but narrow must still work. */
  @media (max-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
      /* A swinging badge must never be able to widen the page. `clip` stops
         the overflow without turning this into a scroll container, which
         `hidden` would do. */
      overflow-x: clip;
    }
  }

  h1 {
    margin-block: 0 var(--space-6);
    font-size: var(--text-display);
    letter-spacing: var(--tracking-display);
  }

  .promise {
    font-size: var(--text-h3);
    color: var(--text-muted);
    max-width: 54ch;
    margin-block: 0 var(--space-8);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    max-width: none;
    margin-block: 0 var(--space-12);
  }

  /* Borders here bound an interactive control, so they use the token that
     clears the 3:1 required for non-text UI — not the decorative hairline. */
  .action {
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .action:hover {
    border-color: var(--text-accent);
  }

  .action--primary {
    border-color: var(--text-accent);
    color: var(--text-accent);
  }

  /* Pulls the badge up through the hero's own top padding, so the strap
     begins immediately below the header rather than part-way down the page. */
  .badge-slot {
    margin-top: calc(var(--hero-top) * -1);
  }

  @media (max-width: 60rem) {
    .badge-slot {
      margin-top: 0;
    }
  }

  .scroll-hint {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-12);
  }

  .rule {
    position: relative;
    display: block;
    width: 1px;
    height: 44px;
    background: var(--border-subtle);
    overflow: hidden;
  }

  /* A bead falling down the rule, once every few seconds. It is the only
     looping motion outside the badge, so it stays slow and nearly silent. */
  .bead {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 14px;
    background: var(--text-accent);
    animation: fall 3.4s var(--ease-out) infinite;
  }

  @keyframes fall {
    0% {
      transform: translateY(-14px);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: translateY(44px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bead {
      animation: none;
      opacity: 1;
    }
  }

  @media (max-width: 30rem) {
    h1 {
      font-size: var(--text-h1);
    }
  }
</style>
