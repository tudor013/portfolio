---
/**
 * Grouped so the list can be scanned by someone hiring for one of the three.
 * No percentages or progress bars: a number against a skill is invented
 * precision, and a reader cannot check it.
 */
const GROUPS = [
  {
    id: 'skills-build',
    title: 'Building',
    items: ['C', 'C++', 'C#', 'Python', 'TypeScript', 'MariaDB', 'Oracle SQL', 'Supabase', 'Cloudflare Workers'],
  },
  {
    id: 'skills-design',
    title: 'Designing',
    items: ['Figma', 'Illustrator', 'Photoshop', 'Spline', 'Premiere Pro', 'DaVinci Resolve'],
  },
  {
    id: 'skills-data',
    title: 'Working with data',
    items: [
      'Inferential statistics',
      'Macroeconomic statistics',
      'Economic cybernetics',
      'Resource allocation',
      'Dynamic programming',
    ],
  },
  {
    id: 'skills-other',
    title: 'Also',
    items: ['Microsoft Security Pro', 'English — IELTS C1', 'Spanish — basic', 'French — basic'],
  },
];
---

<section id="skills" aria-labelledby="skills-heading">
  <div class="head">
    <h2 id="skills-heading">Skills</h2>
  </div>

  <div class="groups">
    {
      GROUPS.map((group) => (
        <section class="group" aria-labelledby={group.id}>
          <h3 id={group.id}>{group.title}</h3>
          <ul>
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</section>

<style>
  section[id='skills'] {
    padding-block: var(--space-12);
  }

  .head {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  h2 {
    margin: 0;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  .group h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-secondary);
    color: var(--text-muted);
    font-weight: var(--weight-medium);
  }

  .group ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .group li {
    font-size: var(--text-secondary);
  }
</style>
