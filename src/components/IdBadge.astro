---
import { Image } from 'astro:assets';
import portrait from '../assets/tudor.png';

// A credential hanging from a lanyard, drawn as DOM rather than canvas or
// WebGL. Everything legible here is real text, so it survives with scripting
// off, can be selected and translated, and reaches assistive technology.
---

<div class="badge" data-badge data-ui>
  <svg class="rope" viewBox="0 0 560 760" aria-hidden="true" preserveAspectRatio="none">
    {/* The static d is what renders before (or without) the script: a strap
        hanging straight down. The simulation overwrites it each frame. */}
    <path data-strap d="M280,0 L280,275" />
  </svg>

  <div class="card" data-card>
    <span class="clip" aria-hidden="true"></span>
    <span class="punch" aria-hidden="true"></span>

    <Image
      src={portrait}
      alt="Tudor-Andrei Ifrim"
      width={220}
      height={220}
      class="portrait"
      loading="eager"
      draggable={false}
    />

    <p class="name">Tudor-Andrei Ifrim</p>
    <p class="role">Software Developer</p>

    <p class="id figures">ID 2028&middot;CSIE</p>
  </div>
</div>

<style>
  .badge {
    position: relative;
    width: 560px;
    height: 760px;
    /* The strap is drawn above its own box while the badge drops in, and
       passes behind the header, which sits on a higher layer. */
    overflow: visible;
    perspective: 1100px;
    perspective-origin: 50% 20%;
    /* A dragged badge must not select the text it passes over, and the card
       itself must not be text a reader can accidentally highlight mid-swing. */
    user-select: none;
    -webkit-user-select: none;
    /* The box is mostly empty air around the strap. It must not sit on top of
       the name beside it and swallow clicks; only the card is a target. */
    pointer-events: none;
  }

  .rope {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .rope path {
    fill: none;
    stroke: var(--badge-strap);
    stroke-width: 11;
    stroke-linecap: butt;
    stroke-linejoin: round;
  }

  .card {
    position: absolute;
    left: 0;
    top: 0;
    width: 200px;
    /* Rotation happens about the point the strap holds. */
    transform-origin: 50% 0;
    transform-style: preserve-3d;
    /* The back of a laminated card still catches light, so the reverse side
       is not simply invisible when it turns past edge-on. */
    backface-visibility: visible;
    /* Static placement for the no-script case. The simulation replaces this
       transform once it starts. */
    transform: translate(180px, 275px) rotate(-3deg);

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4) var(--space-4);

    pointer-events: auto;
    background: var(--badge-card);
    color: var(--ink);
    /* A real card has rounded corners; this is an object, not interface. */
    border-radius: 10px;
    /* It truly hangs in front of the page, so it casts a shadow. */
    box-shadow: var(--badge-shadow); /* taste-skill-ignore */
  }

  /* The grab cursor appears once the simulation is running — which is now
     also the case under reduced motion, where dragging still works. */
  .badge[data-live] .card {
    cursor: grab;
  }
  .badge[data-dragging] .card {
    cursor: grabbing;
  }

  .clip {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 30px;
    height: 24px;
    margin-left: -15px;
    border-radius: 3px 3px 5px 5px;
    background: color-mix(in srgb, var(--badge-strap) 70%, var(--ink));
  }

  .punch {
    width: 46px;
    height: 7px;
    margin-bottom: var(--space-3);
    border-radius: 999px;
    background: var(--ground);
    /* The slot is punched through the card: an inner edge, not elevation. */
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--ink) 35%, transparent); /* taste-skill-ignore */
  }

  .portrait {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 4px;
    /* The press has to reach the card, not the image: otherwise the browser
       starts its own image drag and the badge never moves. */
    pointer-events: none;
    -webkit-user-drag: none;
  }

  /* Nothing inside the card is a separate target. It is one object. */
  .card * {
    pointer-events: none;
  }

  .card p {
    max-width: none;
    text-align: center;
  }

  .name {
    margin-top: var(--space-3);
    font-size: 1rem;
    font-weight: var(--weight-strong);
    line-height: 1.25;
  }

  .role {
    font-size: var(--step-small);
    color: var(--muted);
  }

  .id {
    width: 100%;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    /* The strap's colour printed across the card, like a band on a real ID. */
    border-top: 3px solid var(--badge-strap);
    font-size: var(--step-small);
    font-weight: var(--weight-head);
    color: var(--badge-strap);
  }
</style>

<script>
  import { initBadge } from '../scripts/badge';

  const root = document.querySelector<HTMLElement>('[data-badge]');
  // Reduced motion silences the entrance and the idle sway, but the badge
  // still answers a pointer: motion a person asks for is not the motion that
  // setting is about, and freezing it entirely makes the badge look broken.
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root) initBadge(root, { calm });
</script>
