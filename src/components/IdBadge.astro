---
import { Image, getImage } from 'astro:assets';
import portrait from '../assets/tudor.png';

// The badge in two forms. The DOM card below is what renders without a
// script and in reduced motion: real text, selectable, read by assistive
// technology. In full motion scripts/badge.ts paints the same card onto the
// React Bits lanyard (three.js) in [data-stage] and the DOM card steps back
// to the accessibility tree only.
const face = await getImage({ src: portrait, width: 640, height: 640, format: 'webp' });
---

<div class="badge" data-badge data-ui data-portrait={face.src}>
  <div class="stage" data-stage aria-hidden="true"></div>

  <div class="card" data-card>
    <span class="strap" aria-hidden="true"></span>
    <span class="clip" aria-hidden="true"></span>
    <span class="punch" aria-hidden="true"></span>

    <Image
      src={portrait}
      alt="Tudor-Andrei Ifrim"
      width={220}
      height={220}
      class="portrait"
      loading="eager"
      draggable={false}
    />

    <p class="name">Tudor-Andrei Ifrim</p>
    <p class="role">Software Developer</p>

    {/* The same link the 3D card carries on its back. */}
    <a class="linkedin" data-linkedin href="https://www.linkedin.com/in/tudor-ifrim-697b0b26a/" target="_blank" rel="noopener">
      LinkedIn<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</div>

<style>
  /* The box fills the hero's badge column, top to bottom: the lanyard hangs
     from its top edge, which is the header's bottom edge. */
  .badge {
    position: relative;
    width: 100%;
    height: 100%;
    user-select: none;
    -webkit-user-select: none;
  }

  /* The still strap is drawn upwards without end; the box's top edge, the
     header's bottom edge, is where it is cut. Not while the lanyard runs:
     its stage reaches past the box. */
  .badge:not([data-live]) {
    overflow: clip;
  }

  /* Wider than the badge's column by --swing on the left, so a card pulled
     towards the name is not cut off at the column's edge. The canvas is
     transparent and sits under the hero's text, so the text stays a target. */
  .stage {
    position: absolute;
    inset: 0 0 0 calc(var(--swing, 0px) * -1);
  }

  .stage :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ---- The still card: no script, reduced motion, no WebGL --------------- */

  .card {
    position: absolute;
    left: 50%;
    top: clamp(9rem, 26vh, 15rem);
    width: 200px;
    transform: translateX(-50%) rotate(-3deg);
    transform-origin: 50% 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4) var(--space-4);

    background: var(--badge-card);
    color: var(--ink);
    /* A real card has rounded corners; this is an object, not interface. */
    border-radius: 10px;
    /* It truly hangs in front of the page, so it casts a shadow. */
    box-shadow: var(--badge-shadow); /* taste-skill-ignore */
  }

  /* Once the lanyard draws the card, this one leaves the screen but stays in
     the accessibility tree: the photo's alt and the text still reach a
     screen reader, which the canvas cannot do. */
  .badge[data-live] .card {
    clip-path: inset(50%);
    opacity: 0;
    pointer-events: none;
  }

  /* The strap, straight up to the header. */
  .strap {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    width: 11px;
    height: 100svh;
    margin-left: -5.5px;
    background: var(--badge-strap);
  }

  .clip {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 30px;
    height: 24px;
    margin-left: -15px;
    border-radius: 3px 3px 5px 5px;
    background: color-mix(in srgb, var(--badge-strap) 70%, var(--ink));
  }

  .punch {
    width: 46px;
    height: 7px;
    margin-bottom: var(--space-3);
    border-radius: 999px;
    background: var(--ground);
    /* The slot is punched through the card: an inner edge, not elevation. */
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--ink) 35%, transparent); /* taste-skill-ignore */
  }

  .portrait {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 4px;
    -webkit-user-drag: none;
  }

  .card p {
    max-width: none;
    text-align: center;
  }

  .name {
    margin-top: var(--space-3);
    font-size: 1rem;
    font-weight: var(--weight-strong);
    line-height: 1.25;
  }

  .role {
    font-size: var(--step-small);
    color: var(--muted);
  }

  .linkedin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    margin-top: var(--space-2);
    background: var(--badge-strap);
    color: var(--badge-card);
    font-weight: var(--weight-head);
    text-decoration: none;
  }

  .linkedin:hover {
    background: color-mix(in srgb, var(--badge-strap) 82%, var(--ink));
  }
</style>

<script>
  import { initBadge } from '../scripts/badge';

  const root = document.querySelector<HTMLElement>('[data-badge]');
  if (root) initBadge(root);
</script>
