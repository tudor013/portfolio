---
// Ambient light behind the whole page. Purely decorative, so it is hidden from
// assistive technology and never carries meaning that the text does not.
---

<div class="light" data-scroll-light aria-hidden="true"></div>

<style>
  .light {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .light::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 110vmax;
    height: 110vmax;
    margin-left: -55vmax;
    margin-top: -70vmax;

    background: radial-gradient(
      circle,
      rgb(var(--light-tint) / 0.14) 0%,
      rgb(var(--light-tint) / 0.05) 38%,
      transparent 68%
    );

    /* Opacity and transform are the two properties the compositor can change
       without re-running layout or paint, which is why the light brightens by
       fading rather than by recolouring the gradient. */
    opacity: var(--light-strength, 1);
    transform: translate3d(0, calc(var(--light-y) * 1px), 0);
    will-change: transform;
  }

  /* Someone who asked for less motion keeps the light — it is part of the
     design — but it stops following them. */
  @media (prefers-reduced-motion: reduce) {
    .light::before {
      transform: none;
      opacity: 1;
      will-change: auto;
    }
  }
</style>

<script>
  import { initScrollLight } from '../scripts/scroll-light';

  const root = document.querySelector<HTMLElement>('[data-scroll-light]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && !still) initScrollLight(document.documentElement);
</script>
