---
/**
 * The hero's one bold element: a reading taken from a real system.
 *
 * It is deliberately data-driven and deliberately empty until real numbers
 * exist. Drawing an invented curve here would put a fabricated result on a
 * page whose whole argument is "evidence, not adjectives", so with no data it
 * renders the instrument without the reading.
 */
interface Props {
  /** Y values in source order. Scaled to fit; X is the index. */
  points?: number[];
  label: string;
  caption: string;
}

const { points = [], label, caption } = Astro.props;

const W = 720;
const H = 160;
const GRIDLINES = 4;

// Normalise to the viewBox. A flat series would divide by zero, so it falls
// back to the middle of the box rather than producing NaN path data.
const path = (() => {
  if (points.length < 2) return null;
  const min = Math.min(...points);
  const max = Math.max(...points);
  const span = max - min;
  return points
    .map((value, i) => {
      const x = (i / (points.length - 1)) * W;
      const y = span === 0 ? H / 2 : H - ((value - min) / span) * H;
      return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
})();
---

<figure class="trace">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    role="img"
    aria-label={path ? label : `${label} — awaiting data`}
  >
    {
      Array.from({ length: GRIDLINES + 1 }, (_, i) => (
        <line
          x1="0"
          x2={W}
          y1={(i / GRIDLINES) * H}
          y2={(i / GRIDLINES) * H}
          class="grid"
        />
      ))
    }
    {path && <path d={path} class="line" />}
  </svg>

  <figcaption class="meta">
    {
      path ? (
        caption
      ) : (
        <>TODO(conținut): seria reală — output-ul simulării sau ritmul de commituri.</>
      )
    }
  </figcaption>
</figure>

<style>
  .trace {
    margin: 0;
    padding: var(--space-4);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
  }

  svg {
    display: block;
    width: 100%;
    height: 10rem;
  }

  /* Hairlines, not a chart frame: they give the eye a baseline without
     competing with the trace itself. */
  .grid {
    stroke: var(--border-subtle);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .line {
    fill: none;
    stroke: var(--text-accent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }

  figcaption {
    margin-top: var(--space-3);
  }
</style>
