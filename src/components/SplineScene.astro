---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * An interactive Spline scene, loaded only when someone asks for it.
 *
 * A Spline runtime is several megabytes of WebGL. Embedding one directly
 * would be the single heaviest thing on the site, paid for by every visitor
 * including the ones who never look at it. So the poster is what ships: a
 * real image of the scene, which is all most readers need, with the live
 * version one click away.
 *
 * With scripting off the poster and a link to the scene remain, so the work
 * is still visible and still reachable.
 */
interface Props {
  /** A still of the scene. Required — the component will not render without it. */
  poster: ImageMetadata;
  alt: string;
  title: string;
  /**
   * The scene's PUBLISHED url (https://my.spline.design/...), not the
   * app.spline.design/file/... editor link, which asks viewers to sign in.
   */
  sceneUrl?: string;
  /** Width the live scene is laid out at before being scaled into the frame. */
  viewport?: number;
  /** Hold the page still while the pointer is over the live scene. */
  holdScroll?: boolean;
}

const { poster, alt, title, sceneUrl, viewport, holdScroll = false } = Astro.props;
---

<figure
  class="scene"
  data-scene
  data-src={sceneUrl}
  data-viewport={viewport}
  data-hold-scroll={holdScroll ? '' : undefined}
>
  <div class="frame">
    <Image src={poster} alt={alt} class="poster" loading="lazy" />

    {
      sceneUrl && (
        <button type="button" class="play" data-play>
          Load interactive scene
        </button>
      )
    }
  </div>

  <figcaption class="meta">
    {title}
    {
      sceneUrl && (
        <>
          {'. '}
          <a href={sceneUrl}>Open it in Spline</a>
        </>
      )
    }
  </figcaption>
</figure>

<style>
  .scene {
    margin: 0;
  }

  /* One shape for every scene, poster or live, so loading one never moves
     the page and two scenes side by side line up. */
  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    background: var(--surface);
  }

  /* The whole still, never cropped: the scenes carry text at their edges. */
  .poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .play {
    position: absolute;
    left: 50%;
    bottom: var(--space-4);
    transform: translateX(-50%);

    min-height: 44px;
    padding: var(--space-3) var(--space-6);
    /* Opaque, not glass. This button sits over whatever the scene happens to
       show, and a translucent fill takes its contrast from that image: over
       the dark product scene the label went grey-on-grey. Glass is fine over
       a background this design controls; it is not fine over arbitrary art. */
    background: var(--ground);
    border: 0;
    border-radius: var(--radius);

    color: var(--ink);
    font: inherit;
    font-size: var(--step-body);
    font-weight: var(--weight-head);
    cursor: pointer;
    transition:
      background-color var(--t-hover) ease,
      color var(--t-hover) ease;
  }

  .play:hover {
    background: var(--ink);
    color: var(--ground);
  }

  /* Swapped in once the scene is requested. Without a viewport it fills the
     frame; with one, the script sizes it to that width and scales it down. */
  .frame :global(iframe) {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    transform-origin: 0 0;
  }

  .frame.is-live .poster,
  .frame.is-live .play {
    display: none;
  }

  figcaption {
    margin-top: var(--space-3);
  }
</style>

<script>
  // The iframe is created on click rather than written into the page with a
  // lazy attribute: a lazy iframe still downloads as soon as it nears the
  // viewport, which on a page of scenes is every megabyte anyway.
  //
  // Only one scene runs at a time. Each is a full WebGL runtime, and two of
  // them at once is what makes a laptop's fan start; loading a second scene
  // puts the first back to its poster.
  import { holdPageScroll } from '../scripts/smooth-scroll';

  let unloadCurrent: (() => void) | null = null;

  document.querySelectorAll<HTMLElement>('[data-scene]').forEach((scene) => {
    const button = scene.querySelector<HTMLButtonElement>('[data-play]');
    const frame = scene.querySelector<HTMLElement>('.frame');
    const src = scene.dataset.src;
    if (!button || !frame || !src) return;

    const viewport = Number(scene.dataset.viewport) || 0;
    const holdScroll = 'holdScroll' in scene.dataset;

    button.addEventListener('click', () => {
      unloadCurrent?.();

      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = scene.querySelector('figcaption')?.textContent?.trim() ?? 'Spline scene';
      iframe.allow = 'fullscreen';

      // Laid out at `viewport` pixels wide, at the frame's proportions, then
      // scaled down to the frame: the scene sees the window it was framed for.
      const fit = () => {
        if (!viewport) return;
        const scale = frame.clientWidth / viewport;
        iframe.style.width = `${viewport}px`;
        iframe.style.height = `${frame.clientHeight / scale}px`;
        iframe.style.transform = `scale(${scale})`;
      };
      const resizer = new ResizeObserver(fit);
      resizer.observe(frame);
      fit();

      // A scene driven by the wheel: while the pointer is over it, the page
      // stands still so the wheel moves the scene, not the page.
      let released: (() => void) | null = null;
      const enter = () => {
        released ??= holdPageScroll();
      };
      const leave = () => {
        released?.();
        released = null;
      };
      if (holdScroll) {
        frame.addEventListener('pointerenter', enter);
        frame.addEventListener('pointerleave', leave);
      }

      frame.append(iframe);
      frame.classList.add('is-live');
      // The click that loaded the scene leaves the pointer over it already,
      // and no pointerenter follows for a pointer that does not cross in.
      if (holdScroll && frame.matches(':hover')) enter();

      unloadCurrent = () => {
        resizer.disconnect();
        frame.removeEventListener('pointerenter', enter);
        frame.removeEventListener('pointerleave', leave);
        leave();
        iframe.remove();
        frame.classList.remove('is-live');
        unloadCurrent = null;
      };
    });
  });
</script>
