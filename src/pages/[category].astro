---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import {
  CATEGORIES,
  CATEGORY_LABELS,
  CATEGORY_SLUGS,
  CATEGORY_BLURBS,
} from '../content.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DriftWall from '../components/DriftWall.astro';

// One page per direction. Each is generated from the same template, so a new
// category means one entry in CATEGORIES rather than a new file.
export const getStaticPaths: GetStaticPaths = async () => {
  const published = (await getCollection('projects')).filter((p) => !p.data.draft);

  return CATEGORIES.map((category) => ({
    params: { category: CATEGORY_SLUGS[category] },
    props: {
      category,
      projects: published
        .filter((p) => p.data.category === category)
        .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year),
    },
  }));
};

type Props = {
  category: (typeof CATEGORIES)[number];
  projects: Awaited<ReturnType<typeof getCollection<'projects'>>>;
};

const { category, projects } = Astro.props;
const label = CATEGORY_LABELS[category];
const blurb = CATEGORY_BLURBS[category];
---

{/* Software is the night page: black ground, light-blue ink (Tudor's call). */}
<BaseLayout
  title={`${label} — Tudor-Andrei Ifrim`}
  description={blurb}
  theme={category === 'dev' ? 'night' : 'paper'}
>

  <section class="direction with-field" aria-labelledby="direction-heading">
    {/* Each direction opens on a band of its own, from React Bits, behind
        the title. All three are decorative and hidden from assistive
        technology; without a script the bands stay still or empty.
          Software: Topography, contour lines that rise under the cursor.
          Design:   DriftWall, Tudor's Aruna stills drifting on a tilted wall.
          Data:     GradientASCII, glyphs over a moving gradient. */}
    {category === 'dev' && (
      <div class="field" data-topography aria-hidden="true">
        <canvas></canvas>
      </div>
    )}
    {category === 'design' && (
      <div class="field">
        <DriftWall />
      </div>
    )}
    {category === 'data' && (
      <div class="field" data-ascii aria-hidden="true">
        <canvas></canvas>
      </div>
    )}

    <header class="title">
      {
        category === 'design' ? (
          /* Design only: the title drawn by TechText (React Bits), whose
             letters show their own metrics under the pointer. The real
             heading text stays in the h1 for assistive technology and for
             no script; the canvas is only a picture of it. */
          <h1 id="direction-heading" class="tech-title" data-tech-title>
            <span class="word">{label}</span>
            <span class="tech" data-tech aria-hidden="true"><canvas></canvas></span>
          </h1>
        ) : (
          <h1 id="direction-heading">{label}</h1>
        )
      }
      <p class="blurb">{blurb}</p>
    </header>

    {
      projects.length === 0 ? (
        <p class="empty">TODO(conținut): niciun proiect în această direcție încă.</p>
      ) : (
        <ul class="grid">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </ul>
      )
    }
  </section>

</BaseLayout>

<style>
  .direction {
    padding-block: var(--space-16) var(--space-12);
  }

  .title {
    position: relative;
    z-index: 1;
  }

  h1 {
    margin-block: 0 var(--space-4);
    font-size: var(--step-head);
  }

  /* ---- The opening band, on every direction page ------------------------ */

  .with-field {
    position: relative;
    padding-top: 0;
  }

  /* Full width, whatever the page's frame: a band across the top. */
  .field {
    position: relative;
    height: min(62svh, 36rem);
    /* Straight under the header: cancels the page's top padding. */
    margin-top: calc(var(--space-16) * -1);
    margin-inline: calc(50% - 50vw);
  }

  .field canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* The title sits on a plate of paper that overlaps the band's bottom
     edge, so it reads cleanly whatever the glyphs behind it are doing. */
  .with-field .title {
    width: fit-content;
    max-width: 44rem;
    margin-top: -7rem;
    padding: var(--space-8) var(--space-8) var(--space-2) 0;
    background: var(--ground);
  }

  .with-field .title::before {
    content: '';
    position: absolute;
    inset: 0 0 0 calc(var(--margin) * -1);
    z-index: -1;
    background: var(--ground);
  }

  /* ---- Design: the TechText title --------------------------------------- */

  .tech {
    display: none;
  }

  .tech-title[data-live] .tech {
    position: relative;
    display: block;
    /* Room for the word at display size plus the metric lines around it. */
    height: clamp(9rem, 4rem + 10vw, 15rem);
  }

  .tech canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .blurb {
    margin-block: 0 var(--space-12);
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    padding: var(--space-8);
    background: var(--surface);
    border-radius: var(--radius);
    color: var(--muted);
    max-width: none;
  }
</style>

<script>
  import { motionIsFull } from '../scripts/motion';

  // Design only. Wide screens only, too: on a phone the one-line word would
  // be fitted below the size of the plain heading, which reads better.
  const title = document.querySelector<HTMLElement>('[data-tech-title]');
  const stage = title?.querySelector<HTMLElement>('[data-tech]');
  const techCanvas = stage?.querySelector('canvas');

  if (title && stage && techCanvas) {
    const wide = window.matchMedia('(min-width: 40rem)');
    let stop: (() => void) | null = null;

    const sync = async () => {
      // Once the canvas draws the word, the text leaves the screen (sr-only)
      // but stays the heading's name for a screen reader.
      const word = title.querySelector('.word');
      if (!wide.matches) {
        stop?.();
        stop = null;
        title.removeAttribute('data-live');
        word?.classList.remove('sr-only');
        return;
      }
      if (stop) return;
      const { initTechText } = await import('../scripts/tech-text');
      if (stop || !wide.matches) return;
      // The stage must have its size before the word is fitted to it.
      title.dataset.live = '';
      word?.classList.add('sr-only');
      const tokens = getComputedStyle(document.documentElement);
      stop = initTechText(stage, techCanvas, {
        text: word?.textContent?.trim() ?? '',
        // Only the real family: the generated metric fallback after it has
        // no file, so asking the browser to load it fails the whole load and
        // the canvas would draw in Arial.
        fontFamily: getComputedStyle(title).fontFamily.split(',')[0],
        fontWeight: 600,
        fontSize: 200,
        letterSpacing: -0.02,
        align: 'left',
        accentColor: tokens.getPropertyValue('--accent').trim(),
        intro: motionIsFull() ? 'metrics' : 'none',
        introDuration: 1.6,
      });
    };

    wide.addEventListener('change', () => void sync());
    void sync();
  }

  // Software: the contour field, in the page's light blue on black.
  const topo = document.querySelector<HTMLElement>('[data-topography]');
  const topoCanvas = topo?.querySelector('canvas');
  if (topo && topoCanvas) {
    const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
    void import('../scripts/topography').then(({ initTopography }) =>
      initTopography(topo, topoCanvas, { color: accent, lineCount: 22, glow: 0.5, fog: 0.4 }),
    );
  }

  // Design: the drift wall is already on the page; this sets it moving.
  const wall = document.querySelector<HTMLElement>('[data-drift-wall]');
  if (wall) void import('../scripts/drift-wall').then(({ initDriftWall }) => initDriftWall(wall));

  // Loaded only on the page that has the field.
  const field = document.querySelector<HTMLElement>('[data-ascii]');
  const canvas = field?.querySelector('canvas');

  if (field && canvas) {
    const tokens = getComputedStyle(document.documentElement);
    const token = (name: string) => tokens.getPropertyValue(name).trim();

    void import('../scripts/gradient-ascii').then(({ initGradientAscii }) =>
      initGradientAscii(field, canvas, {
        lightMode: true,
        shape: 'horizon',
        // The page's own blues, lightest to deepest.
        colors: [token('--chalk-300'), token('--blue-400'), token('--blue-700'), token('--blue-800')],
        cellSize: 16,
        density: 0.85,
        glow: 0.15,
        grain: 0.05,
        flow: 0.6,
        speed: 0.8,
      }),
    );
  }
</script>
