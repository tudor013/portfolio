---
import BaseLayout from '../layouts/BaseLayout.astro';

// Cloudflare serves this file for any unmatched path because wrangler.jsonc
// sets not_found_handling to "404-page". Without the file, an unknown URL
// would return an empty response.
//
// Copy follows the errors rule: no blame, under two sentences, and a recovery
// step rather than a diagnosis. "This page doesn't exist" states the system's
// condition; "you typed the wrong address" would accuse the reader.
---

<BaseLayout
  title="Page not found — Tudor-Andrei Ifrim"
  description="That page doesn't exist. The work and contact details are on the home page."
>

  <section class="notfound">
    <h1>This page doesn't exist</h1>
    <p>
      The link may be out of date. The work and contact details are on the home
      page.
    </p>
    <p class="actions">
      <a class="button" href="/#work">See the work</a>
      <a class="go" href="/#contact">Get in touch</a>
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    gap: var(--space-6);
    min-height: 50svh;
    align-content: center;
  }

  h1 {
    font-size: var(--step-head);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-8);
  }
</style>
