---
/**
 * The landing page, rebuilt 27.10.2026 on the "quiet instrument" direction.
 *
 * The idea: Tudor's own models and drawings become scenes that run as you
 * scroll. The order is an argument — who he is, then proof straight away
 * (the schema), the short version, more proof (the market, the brand), every
 * project, the person, and how to reach him.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import SchemaScene from '../components/landing/SchemaScene.astro';
import Intro from '../components/landing/Intro.astro';
import MarketScene from '../components/landing/MarketScene.astro';
import ArunaScene from '../components/landing/ArunaScene.astro';
import Ledger from '../components/landing/Ledger.astro';
import Letter from '../components/landing/Letter.astro';
import Contact from '../components/landing/Contact.astro';
---

<BaseLayout
  title="Tudor-Andrei Ifrim — Software Developer"
  description="Software developer in Bucharest. I build software people enjoy using, for problems they actually have."
  layout="full"
>
  <Hero />
  <SchemaScene />
  <Intro />
  <MarketScene />
  <ArunaScene />
  <Ledger />
  <Letter />
  <Contact />
</BaseLayout>
