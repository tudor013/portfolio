---
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_LABELS } from '../content.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import SkillCategory from '../components/SkillCategory.astro';
import ContactCta from '../components/ContactCta.astro';
import SiteFooter from '../components/SiteFooter.astro';

// Drafts are excluded at build time so an unfinished case study cannot ship.
const published = (await getCollection('projects')).filter((p) => !p.data.draft);

/** One line per category, in Tudor's own terms. */
const BLURBS: Record<(typeof CATEGORIES)[number], string> = {
  dev: 'Mostly C and C++, C#, Python, MariaDB and Oracle SQL, with AI tooling in the loop. I build software that is pleasant to use and solves a problem someone actually has.',
  design: 'Brand design, UI/UX and interface work in Figma, Illustrator, Photoshop and Spline, with motion in Premiere Pro and DaVinci Resolve. I design interfaces around the person using them.',
  data: 'Inferential and macroeconomic statistics, and the economic cybernetics I study: resource allocation, correlation between series, and models whose results have to survive being checked.',
};

// Group once rather than filtering inside the template three times. CATEGORIES
// is ordered dev-first, which is also the order the sections appear in.
const sections = CATEGORIES.map((category) => ({
  category,
  label: CATEGORY_LABELS[category],
  blurb: BLURBS[category],
  projects: published
    .filter((p) => p.data.category === category)
    .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year),
}));
---

<BaseLayout
  title="Tudor-Andrei Ifrim — Software Developer"
  description="TODO(conținut): o propoziție care spune ce rol cauți și de ce te merită."
>
  <SiteHeader />
  <Hero />

  <div id="work">
    {
      sections.map(({ category, label, blurb, projects }) => (
        <SkillCategory
          id={`cat-${category}`}
          label={label}
          blurb={blurb}
          projects={projects}
          primary={category === 'dev'}
        />
      ))
    }
  </div>

  <div id="contact">
    <ContactCta />
  </div>

  <SiteFooter />
</BaseLayout>
