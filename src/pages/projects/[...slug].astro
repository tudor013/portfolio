---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { CATEGORY_LABELS } from '../../content.config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SplineScene from '../../components/SplineScene.astro';

// One static page per published project. Astro calls this at build time, so
// adding a Markdown file is all it takes to get a new page.
export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection('projects');
  return projects
    .filter((project) => !project.data.draft)
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
};

// Declaring Props is what gives Astro.props its type; without it `project`
// is `unknown` and every field access below silently becomes `any`.
type Props = { project: CollectionEntry<'projects'> };

const { project } = Astro.props;
const { Content } = await render(project);
const data = project.data;
---

<BaseLayout title={`${data.title} — Tudor-Andrei Ifrim`} description={data.problem}>

  <article class="case">
    <p class="back"><a href="/#work">Back to all the work</a></p>

    <h1>{data.title}</h1>

    {/* Metadata first: the reader decides in seconds whether this is
        relevant to the role they are hiring for. */}
    <dl class="facts">
      <div>
        <dt class="meta">Category</dt>
        <dd>{CATEGORY_LABELS[data.category]}</dd>
      </div>
      <div>
        <dt class="meta">Year</dt>
        <dd class="figure">{data.year}</dd>
      </div>
      <div>
        <dt class="meta">My role</dt>
        <dd>{data.role}</dd>
      </div>
      <div>
        <dt class="meta">Stack</dt>
        <dd>{data.stack.join(', ')}</dd>
      </div>
    </dl>

    <section class="summary">
      <h2>The problem</h2>
      <p>{data.problem}</p>

      <h2>Outcome</h2>
      <p>{data.results}</p>
    </section>

    {
      data.links.length > 0 && (
        <section aria-labelledby="links-heading">
          <h2 id="links-heading">Links</h2>
          <ul class="links">
            {data.links.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      data.scenes.length > 0 && (
        <section class="scenes" aria-labelledby="scenes-heading">
          <h2 id="scenes-heading">Scenes</h2>
          <div class="scene-grid">
            {data.scenes.map((scene) => (
              <SplineScene
                poster={scene.poster}
                alt={scene.alt}
                title={scene.title}
                sceneUrl={scene.url}
                viewport={scene.viewport}
                holdScroll={scene.holdScroll}
              />
            ))}
          </div>
        </section>
      )
    }

    <div class="story">
      <Content />
    </div>
  </article>

</BaseLayout>

<style>
  .case {
    padding-block: var(--space-12);
  }

  .back {
    margin-block: 0 var(--space-8);
  }

  /* Inside a case study the sections are steps of one story, not chapters
     of the site: they take the lead size, well under the title. */
  .case h2,
  .case :global(h2) {
    margin-block: var(--space-12) var(--space-4);
    font-size: var(--step-lead);
    letter-spacing: 0;
  }

  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  h1 {
    margin-block: 0 var(--space-8);
    font-size: var(--step-head);
  }

  /* The facts on a filled plate, one tone off the ground. */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-6);
    margin: 0 0 var(--space-12);
    padding: var(--space-6);
    background: var(--surface);
    border-radius: var(--radius);
  }

  .facts dt {
    margin-bottom: var(--space-1);
  }

  .facts dd {
    margin: 0;
  }

  /* Prose stays inside a comfortable measure even though the facts plate
     above it spans the full column. */
  .summary,
  .story {
    max-width: var(--measure);
  }

  .links {
    padding-left: var(--space-4);
  }

  .scene-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
    gap: var(--space-6);
    margin-block: var(--space-6) var(--space-12);
  }
</style>
